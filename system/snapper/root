# Snapper config for the root subvolume (installed as /etc/snapper/configs/root).
# snap-pac takes a pre/post pair around every pacman transaction; timeline
# snapshots stay off, so the only snapshots are the ones around changes.
# /home, /var/log and the package cache are separate subvolumes and are not
# included.
SUBVOLUME="/"
FSTYPE="btrfs"
QGROUP=""
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"
BACKGROUND_COMPARISON="yes"

# Each pacman transaction makes a pre and a post snapshot, so 6 snapshots
# cover the last 3 updates.
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="0"
NUMBER_LIMIT="6"
NUMBER_LIMIT_IMPORTANT="3"

TIMELINE_CREATE="no"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="0"
TIMELINE_LIMIT_DAILY="0"
TIMELINE_LIMIT_WEEKLY="0"
TIMELINE_LIMIT_MONTHLY="0"
TIMELINE_LIMIT_QUARTERLY="0"
TIMELINE_LIMIT_YEARLY="0"

EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
