# Package upgrades replace metadata.desktop and reset SilentSDDM to its default
# look. Re-select the theme-coloured variant that dotfiles-boot-theme-root
# writes (configs/dotfiles.conf), or the nord variant before that exists.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = sddm-silent-theme

[Action]
Description = Selecting the SilentSDDM dotfiles variant...
When = PostTransaction
Exec = /usr/bin/sh -c 'm=/usr/share/sddm/themes/silent/metadata.desktop; sed -i -E "s|^ConfigFile=|# ConfigFile=|" "$m"; if [ -f /usr/share/sddm/themes/silent/configs/dotfiles.conf ]; then echo ConfigFile=configs/dotfiles.conf >> "$m"; else sed -i -E "s|^# ConfigFile=configs/nord.conf$|ConfigFile=configs/nord.conf|" "$m"; fi'
