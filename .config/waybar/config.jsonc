        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    // Named workspaces fill these slots in creation order.
    "custom/wsnamed1": {
        "exec": "~/.config/waybar/scripts/workspace.sh named1",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/workspace.sh focus named1",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "custom/wsnamed2": {
        "exec": "~/.config/waybar/scripts/workspace.sh named2",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/workspace.sh focus named2",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "custom/wsnamed3": {
        "exec": "~/.config/waybar/scripts/workspace.sh named3",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/workspace.sh focus named3",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "custom/wsnamed4": {
        "exec": "~/.config/waybar/scripts/workspace.sh named4",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/workspace.sh focus named4",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "custom/wsnamed5": {
        "exec": "~/.config/waybar/scripts/workspace.sh named5",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/workspace.sh focus named5",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "custom/ws-special": {
        "exec": "~/.config/waybar/scripts/workspace.sh special",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/workspace.sh focus special",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "hyprland/window": {
        "format": "{title}",
        "icon": true,
        "icon-size": 15,
        "max-length": 26,
        "separate-outputs": true,
        "rewrite": {
            "": "Desktop"
        }
    },

    // Now playing. Hovering slides out previous/play/next; clicking the track
    // opens the media pop-up (quickshell/panels/MediaView.qml).
    "group/media": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 220,
            "children-class": "media-control",
            "transition-left-to-right": true
        },
        "modules": ["custom/media", "custom/media-previous", "custom/media-toggle", "custom/media-next"]
    },

    "custom/media": {
        "exec": "~/.config/waybar/scripts/media.sh",
        "return-type": "json",
        "escape": true,
        "on-click": "~/.config/hypr/scripts/panel.sh media",
        "on-click-middle": "playerctl play-pause",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },

    "custom/media-previous": {
        "format": "󰒮",
        "tooltip-format": "Previous",
        "on-click": "playerctl previous"
    },

    "custom/media-toggle": {
        "format": "󰐎",
        "tooltip-format": "Play or pause",
        "on-click": "playerctl play-pause"
    },

    "custom/media-next": {
        "format": "󰒭",
        "tooltip-format": "Next",
        "on-click": "playerctl next"
    },

    "custom/search": {
        "format": "󰍉  Search",
        "tooltip-format": "Applications  •  Super+D",
        "on-click": "~/.config/hypr/scripts/apps-menu.sh",
        "on-click-right": "~/.config/hypr/scripts/workspace-overview.sh toggle"
    },

    "clock": {
        "interval": 30,
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%A, %d %B %Y  %H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffffff'><b>{}</b></span>",
                "days": "<span color='#ffffff'>{}</span>",
                "weeks": "<span color='#888888'>W{}</span>",
                "weekdays": "<span color='#aaaaaa'>{}</span>",
                "today": "<span color='#ffffff'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "group/tray": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 220,
            "children-class": "drawer-child",
            "transition-left-to-right": false
        },
        "modules": ["custom/tray", "network", "bluetooth", "custom/emacs", "custom/music", "tray"]
    },

    "custom/tray": {
        "format": "󰕰",
        "tooltip-format": "Wi-Fi, Bluetooth, and background applications"
    },

    // The Emacs server has no tray icon of its own; this stands in for one
    // while it runs (scripts/emacs-tray.sh). Emacs sends signal 9 when it
    // starts and stops; the slow interval only catches a crash.
    "custom/emacs": {
        "exec": "~/.config/waybar/scripts/emacs-tray.sh status",
        "return-type": "json",
        "signal": 9,
        "interval": 60,
        "on-click": "~/.config/waybar/scripts/emacs-tray.sh open",
        "on-click-right": "~/.config/waybar/scripts/emacs-tray.sh menu"
    },

    // Music players running in the Win+H scratchpad, including ncspot.
    "custom/music": {
        "exec": "~/.config/waybar/scripts/music-tray.sh status",
        "return-type": "json",
        "interval": 3,
        "on-click": "~/.config/waybar/scripts/music-tray.sh toggle"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 7,
        "show-passive-items": true
    },

    "network": {
        "interval": 3,
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤮",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\nAddress: {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "Ethernet: {ifname}\nAddress: {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Network disconnected",
        "on-click": "~/.config/hypr/scripts/panel.sh wifi",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱 {num_connections}",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{device_alias}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "~/.config/hypr/scripts/panel.sh bluetooth",
        "on-click-right": "blueman-manager"
    },

    // Shown only while an app is using the NVIDIA GPU; the tooltip names them.
    "custom/dgpu": {
        "exec": "~/.config/waybar/scripts/dgpu-status.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "~/.config/hypr/scripts/gpu-apps.sh"
    },

    "custom/display": {
        "format": "󰍹",
        "tooltip-format": "Display scale and text size  •  Super+Ctrl+S",
        "on-click": "~/.config/hypr/scripts/panel.sh display"
    },

    "group/audio": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 220,
            "children-class": "drawer-child",
            "transition-left-to-right": false
        },
        "modules": ["pulseaudio", "pulseaudio#microphone"]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂰 {volume}%",
        "format-muted": "󰖁",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "tooltip-format": "{desc}\nVolume: {volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "tooltip-format": "Microphone: {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol -t 4"
    },

    "privacy": {
        "icon-spacing": 6,
        "icon-size": 16,
        "transition-duration": 150,
        "modules": [
            {"type": "screenshare", "tooltip": true},
            {"type": "audio-in", "tooltip": true}
        ]
    },

    "battery": {
        "interval": 10,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power}W"
    },

    "group/system": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 220,
            "children-class": "drawer-child",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/system",
            "backlight",
            "power-profiles-daemon",
            "cpu",
            "memory",
            "temperature",
            "disk"
        ]
    },

    "custom/system": {
        "format": "󰍛",
        "tooltip-format": "Power profile  •  hover for system resources",
        "on-click": "~/.config/hypr/scripts/power-profile.sh menu"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
        "scroll-step": 5,
        "tooltip-format": "Brightness: {percent}%"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "󰾆",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰌪"
        },
        "on-click": "~/.config/hypr/scripts/power-profile.sh menu"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%",
        "tooltip-format": "Load: {load}\nFrequency: {avg_frequency} GHz"
    },

    "memory": {
        "interval": 2,
        "format": "RAM {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "temperature": {
        "critical-threshold": 80,
        "interval": 2,
        "format": "{temperatureC}°C",
        "format-critical": "󰸁 {temperatureC}°C",
        "tooltip-format": "CPU temperature: {temperatureC}°C"
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": "SSD {percentage_used}%",
        "tooltip-format": "{used} / {total} used on {path}"
    },

    "group/status": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 220,
            "children-class": "drawer-child",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/notifications",
            "custom/updates",
            "custom/nightlight",
            "idle_inhibitor"
        ]
    },

    "custom/notifications": {
        "exec": "~/.config/waybar/scripts/notifications.sh",
        "return-type": "json",
        // Refreshed by hypr/scripts/notification-dismiss-watch.sh (signal 11)
        // whenever dunst's history or pause state changes.
        "signal": 11,
        "interval": 60,
        "on-click": "dunstctl history-pop",
        "on-click-middle": "sh -c 'dunstctl close-all; dunstctl history-clear'",
        "on-click-right": "dunstctl set-paused toggle"
    },

    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "interval": 1800,
        "signal": 10,
        "on-click": "kitty --class dotfiles-update -e bash -lc 'yay -Syu; read -rp \"Press Enter to close\"'"
    },

    "custom/nightlight": {
        "exec": "~/.config/waybar/scripts/nightlight-status.sh",
        "return-type": "json",
        // Refreshed by scripts/toggle-gammastep (signal 12).
        "signal": 12,
        "interval": 60,
        "on-click": "~/.config/waybar/scripts/toggle-gammastep"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Idle lock inhibited",
        "tooltip-format-deactivated": "Idle lock enabled"
    },

    "group/session": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 220,
            "children-class": "drawer-child",
            "transition-left-to-right": false
        },
        "modules": ["custom/settings", "custom/power"]
    },

    "custom/settings": {
        "format": "󰒓",
        "tooltip-format": "Setup  •  right-click for defaults",
        "on-click": "~/.config/hypr/scripts/desktop-menu.sh setup",
        "on-click-right": "~/.config/hypr/scripts/defaults-menu.sh"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power and session menu  •  Super+Grave",
        "on-click": "~/.config/hypr/scripts/power-menu.sh"
    }
}
