{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "fixed-center": true,
    "height": 36,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/launcher",
        "group/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "custom/search",
        "clock"
    ],
    "modules-right": [
        "group/media",
        "privacy",
        "custom/dgpu",
        "group/tray",
        "group/audio",
        "custom/display",
        "battery",
        "group/system",
        "group/status",
        "group/session"
    ],

    "custom/launcher": {
        "format": "󰣇",
        "tooltip-format": "Desktop menu  •  Super+Escape",
        "on-click": "~/.config/hypr/scripts/desktop-menu.sh",
        "on-click-right": "~/.config/hypr/scripts/keybinds.sh"
    },

    // Clickable workspace buttons. The built-in hyprland/workspaces module
    // switches with a legacy IPC call that Hyprland's Lua config rejects,
    // so these use scripts/workspace.sh (hl.dsp) instead.
    "group/workspaces": {
        "orientation": "inherit",
        "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10", "custom/ws11", "custom/ws12", "custom/ws13", "custom/ws14", "custom/ws15", "custom/ws16", "custom/ws17", "custom/ws18", "custom/ws19", "custom/ws20", "custom/wsnamed1", "custom/wsnamed2", "custom/wsnamed3", "custom/wsnamed4", "custom/wsnamed5", "custom/ws-special", "custom/ws-watch"]
    },

    "custom/ws-watch": {
        "exec": "~/.config/waybar/scripts/workspace-watch.sh"
    },

    "custom/ws1": {
        "exec": "~/.config/waybar/scripts/workspace.sh 1",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/workspace.sh focus 1",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "custom/ws2": {
        "exec": "~/.config/waybar/scripts/workspace.sh 2",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/workspace.sh focus 2",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "custom/ws3": {
        "exec": "~/.config/waybar/scripts/workspace.sh 3",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/workspace.sh focus 3",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

