{
    "layer": "top",
    "position": "top",
    "exclusive": true, // "false" 
    "spacing": 0,

    "modules-left": ["cpu", "memory", "temperature"],
    "modules-center": ["clock"],
    "modules-right": ["custom/mpris-marquee", "pulseaudio", "power-profiles-daemon", "battery", "custom/power"],

    "cpu": {
        "interval": 1,
        "format": "CPU {usage}%",
    },

    "memory": {
        "interval": 1,
        "format": "RAM {percentage}%",
        "tooltip-format": "{used} / {total}GiB",
    },

    "temperature": {
        "critical-threshold": 80,
        "interval": 1,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "tooltip": true,
        "tooltip-format": "CPU Temp: {temperatureC}°C",
        "on-click": "~/.config/waybar/scripts/toggle-gammastep"
    },
//  "format": "{:%H:%M}",
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    },

    "custom/mpris-marquee": {
        "exec": "~/.config/waybar/scripts/mpris-marquee.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" play-pause",
        "on-click-right": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" next",
        "on-click-middle": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" previous"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip": false,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // https://man.archlinux.org/man/waybar-battery.5
    "battery": {
        "interval": 10,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power}W",
    },

    // https://man.archlinux.org/man/waybar-power-profiles-daemon.5
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "󰾆",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰌪"
        }
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "pgrep -x wlogout >/dev/null || wlogout -b 1 -c 20 -r 20 -L 1700 -R 1700 -T 325 -B 325"
    }
}
