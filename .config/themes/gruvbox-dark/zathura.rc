# zathura colours for this theme, included by zathura/zathurarc.
# Generated by themes/generate.py from colors.toml.
set default-bg "#282828"
set default-fg "#d4be98"
set statusbar-bg "#3c3836"
set statusbar-fg "#d4be98"
set inputbar-bg "#282828"
set inputbar-fg "#d4be98"
set notification-bg "#3c3836"
set notification-fg "#d4be98"
set notification-error-bg "#3c3836"
set notification-error-fg "#ea6962"
set notification-warning-bg "#3c3836"
set notification-warning-fg "#d8a657"
set highlight-color "rgba(216, 166, 87, 0.35)"
set highlight-active-color "rgba(125, 174, 163, 0.45)"
set completion-bg "#3c3836"
set completion-fg "#d4be98"
set completion-group-bg "#282828"
set completion-group-fg "#928374"
set completion-highlight-bg "#7daea3"
set completion-highlight-fg "#000000"
set index-bg "#282828"
set index-fg "#d4be98"
set index-active-bg "#504945"
set index-active-fg "#f2e5bc"
set recolor-lightcolor "#282828"
set recolor-darkcolor "#d4be98"
