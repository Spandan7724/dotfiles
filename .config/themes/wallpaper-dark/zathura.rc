# zathura colours for this theme, included by zathura/zathurarc.
# Generated by themes/generate.py from colors.toml.
set default-bg "#0f1416"
set default-fg "#dee3e6"
set statusbar-bg "#252b2d"
set statusbar-fg "#dee3e6"
set inputbar-bg "#0f1416"
set inputbar-fg "#dee3e6"
set notification-bg "#252b2d"
set notification-fg "#dee3e6"
set notification-error-bg "#252b2d"
set notification-error-fg "#ffb4ab"
set notification-warning-bg "#252b2d"
set notification-warning-fg "#e2c46d"
set highlight-color "rgba(226, 196, 109, 0.35)"
set highlight-active-color "rgba(137, 208, 237, 0.45)"
set completion-bg "#252b2d"
set completion-fg "#dee3e6"
set completion-group-bg "#0f1416"
set completion-group-fg "#c0c8cc"
set completion-highlight-bg "#89d0ed"
set completion-highlight-fg "#000000"
set index-bg "#0f1416"
set index-fg "#dee3e6"
set index-active-bg "#354a53"
set index-active-fg "#dee3e6"
set recolor-lightcolor "#0f1416"
set recolor-darkcolor "#dee3e6"
