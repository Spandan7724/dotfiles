# zathura colours for this theme, included by zathura/zathurarc.
# Generated by themes/generate.py from colors.toml.
set default-bg "#101315"
set default-fg "#cacccc"
set statusbar-bg "#1b1e20"
set statusbar-fg "#cacccc"
set inputbar-bg "#101315"
set inputbar-fg "#cacccc"
set notification-bg "#1b1e20"
set notification-fg "#cacccc"
set notification-error-bg "#1b1e20"
set notification-error-fg "#de6145"
set notification-warning-bg "#1b1e20"
set notification-warning-fg "#d6b46e"
set highlight-color "rgba(214, 180, 110, 0.35)"
set highlight-active-color "rgba(121, 129, 134, 0.45)"
set completion-bg "#1b1e20"
set completion-fg "#cacccc"
set completion-group-bg "#101315"
set completion-group-fg "#8a9095"
set completion-highlight-bg "#798186"
set completion-highlight-fg "#000000"
set index-bg "#101315"
set index-fg "#cacccc"
set index-active-bg "#343d41"
set index-active-fg "#a5aeb4"
set recolor-lightcolor "#101315"
set recolor-darkcolor "#cacccc"
