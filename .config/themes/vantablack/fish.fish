# fish colours for this theme; themes/apply.sh sources this in fish, and the
# universal variables reach shells that are already open.
# Generated by themes/generate.py from colors.toml.
set -U fish_color_normal ffffff
set -U fish_color_command dcdcdc
set -U fish_color_keyword ffffff --bold
set -U fish_color_quote a6a6a6 --italics
set -U fish_color_redirection 8c8c8c
set -U fish_color_end 8c8c8c
set -U fish_color_error e5534b
set -U fish_color_param ececec
set -U fish_color_option c4c4c4
set -U fish_color_comment 5e5e5e --italics
set -U fish_color_operator 8c8c8c
set -U fish_color_escape bebebe
set -U fish_color_autosuggestion 7a7a7a
set -U fish_color_valid_path --underline
set -U fish_color_cancel e5534b
set -U fish_color_selection ffffff --background=1a1a1a
set -U fish_color_search_match ffffff --background=1a1a1a
set -U fish_color_history_current --bold
set -U fish_color_user b6b6b6
set -U fish_color_host 8d8d8d
set -U fish_color_cwd 8d8d8d
set -U fish_color_cwd_root e5534b
set -U fish_pager_color_prefix 8d8d8d --bold
set -U fish_pager_color_completion ffffff
set -U fish_pager_color_description 7a7a7a
set -U fish_pager_color_progress 000000 --background=8d8d8d
set -U fish_pager_color_selected_background --background=1a1a1a
