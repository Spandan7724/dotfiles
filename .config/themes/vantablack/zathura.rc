# zathura colours for this theme, included by zathura/zathurarc.
# Generated by themes/generate.py from colors.toml.
set default-bg "#000000"
set default-fg "#ffffff"
set statusbar-bg "#1a1a1a"
set statusbar-fg "#ffffff"
set inputbar-bg "#000000"
set inputbar-fg "#ffffff"
set notification-bg "#1a1a1a"
set notification-fg "#ffffff"
set notification-error-bg "#1a1a1a"
set notification-error-fg "#e5534b"
set notification-warning-bg "#1a1a1a"
set notification-warning-fg "#d7a95f"
set highlight-color "rgba(215, 169, 95, 0.35)"
set highlight-active-color "rgba(141, 141, 141, 0.45)"
set completion-bg "#1a1a1a"
set completion-fg "#ffffff"
set completion-group-bg "#000000"
set completion-group-fg "#7a7a7a"
set completion-highlight-bg "#8d8d8d"
set completion-highlight-fg "#000000"
set index-bg "#000000"
set index-fg "#ffffff"
set index-active-bg "#1a1a1a"
set index-active-fg "#ffffff"
set recolor-lightcolor "#000000"
set recolor-darkcolor "#ffffff"
