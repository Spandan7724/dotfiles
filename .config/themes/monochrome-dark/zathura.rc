# zathura colours for this theme, included by zathura/zathurarc.
# Generated by themes/generate.py from colors.toml.
set default-bg "#000000"
set default-fg "#f5f5f5"
set statusbar-bg "#1b1b1b"
set statusbar-fg "#f5f5f5"
set inputbar-bg "#000000"
set inputbar-fg "#f5f5f5"
set notification-bg "#1b1b1b"
set notification-fg "#f5f5f5"
set notification-error-bg "#1b1b1b"
set notification-error-fg "#d75f5f"
set notification-warning-bg "#1b1b1b"
set notification-warning-fg "#d7af5f"
set highlight-color "rgba(215, 175, 95, 0.35)"
set highlight-active-color "rgba(255, 255, 255, 0.45)"
set completion-bg "#1b1b1b"
set completion-fg "#f5f5f5"
set completion-group-bg "#000000"
set completion-group-fg "#a2a2a2"
set completion-highlight-bg "#ffffff"
set completion-highlight-fg "#000000"
set index-bg "#000000"
set index-fg "#f5f5f5"
set index-active-bg "#303030"
set index-active-fg "#ffffff"
set recolor-lightcolor "#000000"
set recolor-darkcolor "#f5f5f5"
