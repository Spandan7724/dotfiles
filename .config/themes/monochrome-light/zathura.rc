# zathura colours for this theme, included by zathura/zathurarc.
# Generated by themes/generate.py from colors.toml.
set default-bg "#f4f4f4"
set default-fg "#151515"
set statusbar-bg "#ffffff"
set statusbar-fg "#151515"
set inputbar-bg "#f4f4f4"
set inputbar-fg "#151515"
set notification-bg "#ffffff"
set notification-fg "#151515"
set notification-error-bg "#ffffff"
set notification-error-fg "#a83232"
set notification-warning-bg "#ffffff"
set notification-warning-fg "#806420"
set highlight-color "rgba(128, 100, 32, 0.35)"
set highlight-active-color "rgba(0, 0, 0, 0.45)"
set completion-bg "#ffffff"
set completion-fg "#151515"
set completion-group-bg "#f4f4f4"
set completion-group-fg "#666666"
set completion-highlight-bg "#000000"
set completion-highlight-fg "#ffffff"
set index-bg "#f4f4f4"
set index-fg "#151515"
set index-active-bg "#c8c8c8"
set index-active-fg "#000000"
set recolor-lightcolor "#f4f4f4"
set recolor-darkcolor "#151515"
