# zathura colours for this theme, included by zathura/zathurarc.
# Generated by themes/generate.py from colors.toml.
set default-bg "#2d353b"
set default-fg "#d3c6aa"
set statusbar-bg "#343f44"
set statusbar-fg "#d3c6aa"
set inputbar-bg "#2d353b"
set inputbar-fg "#d3c6aa"
set notification-bg "#343f44"
set notification-fg "#d3c6aa"
set notification-error-bg "#343f44"
set notification-error-fg "#e67e80"
set notification-warning-bg "#343f44"
set notification-warning-fg "#dbbc7f"
set highlight-color "rgba(219, 188, 127, 0.35)"
set highlight-active-color "rgba(127, 187, 179, 0.45)"
set completion-bg "#343f44"
set completion-fg "#d3c6aa"
set completion-group-bg "#2d353b"
set completion-group-fg "#859289"
set completion-highlight-bg "#7fbbb3"
set completion-highlight-fg "#000000"
set index-bg "#2d353b"
set index-fg "#d3c6aa"
set index-active-bg "#3d484d"
set index-active-fg "#fff9e8"
set recolor-lightcolor "#2d353b"
set recolor-darkcolor "#d3c6aa"
