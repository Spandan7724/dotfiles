# zathura colours for this theme, included by zathura/zathurarc.
# Generated by themes/generate.py from colors.toml.
set default-bg "#1a1b26"
set default-fg "#c0caf5"
set statusbar-bg "#24283b"
set statusbar-fg "#c0caf5"
set inputbar-bg "#1a1b26"
set inputbar-fg "#c0caf5"
set notification-bg "#24283b"
set notification-fg "#c0caf5"
set notification-error-bg "#24283b"
set notification-error-fg "#f7768e"
set notification-warning-bg "#24283b"
set notification-warning-fg "#e0af68"
set highlight-color "rgba(224, 175, 104, 0.35)"
set highlight-active-color "rgba(122, 162, 247, 0.45)"
set completion-bg "#24283b"
set completion-fg "#c0caf5"
set completion-group-bg "#1a1b26"
set completion-group-fg "#737aa2"
set completion-highlight-bg "#7aa2f7"
set completion-highlight-fg "#000000"
set index-bg "#1a1b26"
set index-fg "#c0caf5"
set index-active-bg "#292e42"
set index-active-fg "#c0caf5"
set recolor-lightcolor "#1a1b26"
set recolor-darkcolor "#c0caf5"
