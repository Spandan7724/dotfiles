# zathura colours for this theme, included by zathura/zathurarc.
# Generated by themes/generate.py from colors.toml.
set default-bg "#f5fafd"
set default-fg "#171c1f"
set statusbar-bg "#e4e9ec"
set statusbar-fg "#171c1f"
set inputbar-bg "#f5fafd"
set inputbar-fg "#171c1f"
set notification-bg "#e4e9ec"
set notification-fg "#171c1f"
set notification-error-bg "#e4e9ec"
set notification-error-fg "#ba1a1a"
set notification-warning-bg "#e4e9ec"
set notification-warning-fg "#725c0c"
set highlight-color "rgba(114, 92, 12, 0.35)"
set highlight-active-color "rgba(10, 103, 128, 0.45)"
set completion-bg "#e4e9ec"
set completion-fg "#171c1f"
set completion-group-bg "#f5fafd"
set completion-group-fg "#40484c"
set completion-highlight-bg "#0a6780"
set completion-highlight-fg "#ffffff"
set index-bg "#f5fafd"
set index-fg "#171c1f"
set index-active-bg "#cfe6f1"
set index-active-fg "#171c1f"
set recolor-lightcolor "#f5fafd"
set recolor-darkcolor "#171c1f"
