* {
    bg: #{{ colors.surface.default.hex_stripped }}f2;
    bg-alt: #{{ colors.surface_container.default.hex_stripped }}f2;
    bg-hover: #{{ colors.surface_container_high.default.hex_stripped }}ff;
    bg-selected: #{{ colors.primary_container.default.hex_stripped }}ff;
    fg: #{{ colors.on_surface.default.hex_stripped }}ff;
    fg-muted: #{{ colors.on_surface_variant.default.hex_stripped }}ff;
    fg-dark: #{{ colors.on_primary_container.default.hex_stripped }}ff;
    accent: #{{ colors.primary.default.hex_stripped }}ff;
    accent-soft: #{{ colors.primary.default.hex_stripped }}33;
    urgent: #{{ colors.error.default.hex_stripped }}ff;
    border-color: #{{ colors.outline_variant.default.hex_stripped }}ff;
}
