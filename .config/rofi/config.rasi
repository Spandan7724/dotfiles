@import "colors.rasi"
@import "../themes/current/rofi.rasi"

configuration {
    modes: "combi";
    combi-modes: "window,run,drun";
    drun-display-format: "{name}";
    window-format: "{t:45}  ·  {c}";
    font: "Iosevka Nerd Font Mono 13";
    icon-theme: "Papirus";

    location: 0;
    fixed-num-lines: true;
    show-icons: true;
    sidebar-mode: false;
    scroll-method: 1;

    /* Substring matching per token. "prefix" only ever matched the start of a
       word, so "paper" never found "wallpaper". "fuzzy" went too far the other
       way: matching scattered letters across the hidden keyword column made
       almost every row match almost every query, so "idle" buried the one row
       that actually says idle under rows that merely contain i, d, l and e. */
    matching: "normal";
    tokenize: true;
    sort: true;
    sorting-method: "fzf";

    click-to-exit: true;
    combi-hide-mode-prefix: true;

    /* A single left click activates the row. The default only moved the
       highlight, so clicking an entry appeared to do nothing. */
    me-select-entry: "";
    me-accept-entry: "MousePrimary";

    display-run: "";
    display-window: "󰖯";
    display-drun: "󰀻";
    display-combi: "󰘔";
    display-ssh: "";
}

* {
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 460px;
    background-color: @bg;
    border: 1px;
    border-color: @border-color;
    /* Radii track Hyprland's decoration:rounding so a rofi card reads as part
       of the same desktop rather than a widget dropped on top of it. */
    border-radius: 12px;
    padding: 16px;
}

mainbox {
    orientation: vertical;
    background-color: transparent;
    spacing: 12px;
    children: [inputbar, listview];
}

inputbar {
    background-color: transparent;
    border: 0;
    padding: 0 4px;
    spacing: 8px;
    children: [prompt, entry];
}

prompt {
    enabled: true;
    background-color: transparent;
    text-color: @fg-muted;
    font: "Iosevka Nerd Font Mono 13";
    vertical-align: 0.5;
}

entry {
    background-color: transparent;
    text-color: @fg;
    font: "Iosevka Nerd Font Mono 13";
    placeholder: "Type to search";
    placeholder-color: @fg-muted;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    background-color: transparent;
    border: 0;
    spacing: 2px;
    lines: 9;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: true;
    cycle: true;
}

element {
    background-color: transparent;
    /* Every row carries the edge so nothing shifts when it lights up. */
    border: 1px;
    border-color: transparent;
    border-radius: 8px;
    padding: 8px 12px;
    spacing: 12px;
    cursor: pointer;
}

element-icon {
    size: 24px;
    background-color: transparent;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    font: "Iosevka Nerd Font Mono 12";
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @urgent;
}

/* Selection reads as accent-on-tint. It used to paint @fg-dark on @bg-selected,
   which on the themed palettes is background-coloured text on a barely-tinted
   background, so the highlighted row was the hardest one to read. */
element selected.normal,
element selected.active {
    background-color: @accent-soft;
    border-color: @accent;
    text-color: @accent;
}

element selected.urgent {
    background-color: @urgent;
    border-color: @urgent;
    text-color: @fg-dark;
}

message {
    background-color: transparent;
    border: 0;
    padding: 0 4px 2px;
    text-color: @fg-muted;
}

textbox {
    background-color: transparent;
    text-color: @fg-muted;
    horizontal-align: 0.0;
}

sidebar {
    background-color: transparent;
    border: 0;
    padding: 0;
}

button {
    background-color: @bg-alt;
    text-color: @fg-muted;
    border: 1px;
    border-color: @border-color;
    border-radius: 8px;
    padding: 8px 14px;
    margin: 2px;
    cursor: pointer;
}

button selected {
    background-color: @accent-soft;
    text-color: @accent;
    border-color: @accent;
}

scrollbar {
    width: 3px;
    border: 0;
    border-radius: 3px;
    handle-color: @accent-soft;
    handle-width: 3px;
    padding: 0;
}

case-indicator {
    spacing: 0;
    text-color: @fg-muted;
}

textbox-prompt-colon {
    expand: false;
    str: "";
    text-color: inherit;
}
